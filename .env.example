# Copy to .env.local and fill in. Also set these in Vercel → Project → Settings → Environment Variables.

# Stripe — required for checkout. Dashboard → Developers → API keys.
# Use the TEST secret key (sk_test_...) until you're ready to take real payments,
# then swap in the live key (sk_live_...).
STRIPE_SECRET_KEY=sk_test_xxx

# Sales tax. Leave unset/false until Stripe Tax is configured in the Dashboard
# (Settings → Tax → add an origin address + register in your nexus states).
# Then set to true — checkout will add tax from the shipping address. If set to
# true before Stripe Tax is configured, checkout errors.
STRIPE_TAX_ENABLED=false

# Public site origin, used to build Stripe success/cancel URLs.
# Local dev can leave this unset (it falls back to the request origin).
# In production set it to the real domain, e.g. https://charah-foods.com
NEXT_PUBLIC_SITE_URL=

# Stripe webhook — Dashboard → Developers → Webhooks → add an endpoint at
# <your domain>/api/webhooks/stripe, listening for checkout.session.completed.
# Paste its signing secret here. Without this, orders still get paid but
# nothing gets pushed to Shippo and no confirmation email goes out.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend — order emails. resend.com → API Keys. Sending domain must be
# verified there first (charah-foods.com).
RESEND_API_KEY=re_xxx
# Optional — defaults to Charah <orders@charah-foods.com>.
RESEND_FROM_EMAIL=
# Where every internal order-flow email goes (new order, shipped, delivered).
# Defaults to orders@charah-foods.com if unset -- only set this if that inbox
# isn't set up yet, or the address should ever change.
ORDER_NOTIFICATION_EMAIL=

# Shippo — pushes each paid order in as a Shippo Order, ready to fulfil.
# Dashboard → Settings → API. Use the test token until you're ready to buy
# real labels, then swap in the live one.
SHIPPO_API_KEY=shippo_test_xxx
