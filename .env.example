# Copy to .env.local and fill in. Also set these in Vercel → Project → Settings → Environment Variables.

# Stripe — required for checkout. Dashboard → Developers → API keys.
# Use the TEST secret key (sk_test_...) until you're ready to take real payments,
# then swap in the live key (sk_live_...).
STRIPE_SECRET_KEY=sk_test_xxx

# Sales tax. Leave unset/false until Stripe Tax is configured in the Dashboard
# (Settings → Tax → add an origin address + register in your nexus states).
# Then set to true — checkout will add tax from the shipping address. If set to
# true before Stripe Tax is configured, checkout errors.
STRIPE_TAX_ENABLED=false

# Public site origin, used to build Stripe success/cancel URLs.
# Local dev can leave this unset (it falls back to the request origin).
# In production set it to the real domain, e.g. https://charah-foods.com
NEXT_PUBLIC_SITE_URL=
